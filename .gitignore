# Xcode project file is GENERATED by XcodeGen from project.yml.
# Never commit it: a merge conflict in a pbxproj is unresolvable by hand,
# and two people adding a file produces one every time.
*.xcodeproj/
*.xcworkspace/

# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.moved-aside
.DS_Store

# Dependencies
Pods/
.swiftpm/
*.resolved

# 🚨 Secrets. Nothing in Config/*.local.xcconfig is committed, and the EPX
# key is never written to a file at all -- it lives in the iPad's Keychain,
# entered on the device. See docs/DECISIONS.md.
Config/*.local.xcconfig
*.p8
*.p12
*.mobileprovision
